rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The admin is one email, written here and nowhere a client can reach.
    // No document anyone can create can confer it — which is the whole point
    // of keeping 'admin' out of the role field below.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'kintegracion@gmail.com';
    }

    // The shape of a profile, checked against the document as it will be
    // *after* the write — so a partial update is judged on the merged result
    // and cannot sneak a bad field past by simply omitting the good ones.
    function validProfile() {
      return request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.role in ['learner', 'teacher']
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80;
    }

    // A person's own profile: users/{uid} -> { email, displayName, role, createdAt }
    //
    // You may read and write only your own. Teachers self-declare, so 'teacher'
    // is a role you may give yourself — it grants nothing on its own; authority
    // over a class will come from owning that class. Any other value, including
    // anything resembling 'admin', is refused outright.
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);

      // Create and update are kept apart rather than folded together behind a
      // `resource == null` test: separating them says exactly the same thing
      // without depending on what `resource` is when there is no document.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && validProfile()
        && request.resource.data.createdAt is int;

      // createdAt is stamped once, on create, and never moves again.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;

      // You may erase yourself, and only yourself. The app deletes this
      // document *before* the Firebase Auth account, because once the account
      // is gone there is no token left to authorise this and the profile would
      // sit here orphaned. Not even the admin may delete someone else's — an
      // account is the person's to end, and there is no reason for the owner
      // of the lessons to reach into it.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // A learner's own list of the classes they have asked to join. Nobody
    // else's business: a teacher reads their roster under the class, not here.
    match /users/{uid}/enrolments/{classId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    function classOwner(classId) {
      return request.auth != null
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
    }

    // A class. Readable by the teacher who owns it and by anyone who has asked
    // to join — pending learners included, so they can see whose class they
    // knocked on while they wait.
    match /classes/{classId} {
      allow read: if request.auth != null
        && (resource.data.teacherUid == request.auth.uid
            || exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)));

      allow create: if request.auth != null
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['name', 'teacherUid', 'teacherName', 'joinCode', 'createdAt', 'active'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.joinCode is string
        && request.resource.data.createdAt is int
        && request.resource.data.active is bool;

      // The owner may rename it or close it. Who owns it, its code and its
      // age are fixed — a class that could change hands silently would take
      // its whole roster with it.
      allow update: if request.auth != null
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name.size() <= 80;

      allow delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;

      // The class note sheet: one per lesson, written by the teacher and read
      // by everyone on the roster. A learner's own notes are not here and are
      // never uploaded — this layer is the teacher's, and only theirs.
      match /notes/{lessonId} {
        allow read: if request.auth != null
          && (classOwner(classId)
              || exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)));

        allow create, update: if classOwner(classId)
          && request.resource.data.keys().hasOnly(['body', 'updatedAt'])
          && request.resource.data.body is string
          && request.resource.data.body.size() < 1000000
          && request.resource.data.updatedAt is int;

        allow delete: if classOwner(classId);
      }

      // Links to the teacher's recorded sessions. A pointer, never a copy:
      // the recording itself lives wherever the teacher put it.
      //
      // Read is narrower than the note sheet above, which any membership
      // document opens. A recording link is a way IN to something, so a
      // pending request must not carry it — being on the waiting list is not
      // being in the class. Someone deactivated keeps the archive, the same
      // way they keep the notes written up to that point.
      //
      // Deliberately not written against `resource`: that would make a list
      // query fail outright the moment one document in it failed, rather than
      // returning the rest.
      match /recordings/{recordingId} {
        function standing() {
          return get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.status;
        }

        allow read: if request.auth != null
          && (classOwner(classId)
              || (exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid))
                  && standing() in ['approved', 'removed']));

        // https only, and checked here as well as in the app: a link posted to
        // a class is a link other people tap, and `javascript:` or `http:`
        // must not be able to reach that position through a stale client.
        function validRecording() {
          return request.resource.data.keys().hasOnly(
                   ['title', 'url', 'passcode', 'note', 'recordedAt', 'createdAt', 'lessonId'])
            && request.resource.data.url is string
            && request.resource.data.url.matches('^https://.+')
            && request.resource.data.url.size() <= 500
            && request.resource.data.title is string
            && request.resource.data.title.size() <= 120
            && request.resource.data.passcode is string
            && request.resource.data.passcode.size() <= 60
            && request.resource.data.note is string
            && request.resource.data.note.size() <= 500
            && request.resource.data.recordedAt is int
            && request.resource.data.createdAt is int
            && request.resource.data.lessonId is int;
        }

        allow create: if classOwner(classId) && validRecording();

        // Corrections are expected — a mistyped passcode, a link that expired
        // and was re-shared. When it was posted is not one of them.
        allow update: if classOwner(classId)
          && validRecording()
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if classOwner(classId);
      }

      // One learner's standing in this class.
      match /members/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || classOwner(classId));

        // You enrol yourself, and you arrive pending. Nobody can write
        // themselves in as approved.
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['displayName', 'status', 'requestedAt', 'decidedAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.requestedAt is int;

        // Only the teacher decides. A learner cannot promote themselves, and
        // re-applying after being removed is the teacher's call too.
        allow update: if classOwner(classId)
          && request.resource.data.status in ['pending', 'approved', 'removed']
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.requestedAt == resource.data.requestedAt;

        // A learner may leave; a teacher may strike someone off entirely.
        allow delete: if request.auth != null && (request.auth.uid == uid || classOwner(classId));
      }
    }

    // code → class. Fetchable by anyone signed in who knows the exact code,
    // and never listable: that is the whole point of keeping it separate from
    // the class document, which stays private.
    match /joinCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      // Only for a class that already exists and is yours, so nobody can mint
      // a code that points at someone else's roster.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['classId', 'teacherUid'])
        && request.resource.data.teacherUid == request.auth.uid
        && classOwner(request.resource.data.classId);

      // Codes do not change. Retiring one means deleting it.
      allow update: if false;
      allow delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
    }

    // Letter-timing calibrations, one doc per word:
    //   calibrations/{lessonId}/words/{wordId}  ->  { b: [boundary seconds] }
    //
    // Anyone can read (learners need the timings). Only the admin —
    // authenticated via Firebase Auth with this exact email — can write,
    // and writes are shape-validated. Clients also re-validate on read
    // (monotonic, letter count) with words.json as the fallback.
    // What the public sees: which lessons are published and which features
    // are switched on. Everyone reads it; only the admin changes it.
    match /config/app {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'kintegracion@gmail.com';
    }

    match /calibrations/{lessonId}/words/{wordId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.token.email == 'kintegracion@gmail.com'
        && request.resource.data.keys().hasOnly(['b'])
        && request.resource.data.b is list
        && request.resource.data.b.size() >= 2
        && request.resource.data.b.size() <= 12;
      allow delete: if request.auth != null
        && request.auth.token.email == 'kintegracion@gmail.com';
    }
  }
}
