  "sections": [
    {
      "id": "p28",
      "title": "Three-Letter Words",
      "titleArabic": "",
      "hint": "Warm-up! ر د ذ ز و never join the letter after them."
    },
    {
      "id": "p29",
      "title": "Three-Letter Words",
      "titleArabic": "",
      "hint": "Watch the dots! ـجـ has a dot below, ـحـ has none, ـخـ has a dot above."
    },
    {
      "id": "p30",
      "title": "Three-Letter Words",
      "titleArabic": "",
      "hint": "Mufakham (heavy) letters خ ص ض غ ط ق ظ: deep, full sound. Muraqqaq (light) letters: light sound."
    },
    {
      "id": "p31",
      "title": "Three-Letter Words",
      "titleArabic": "",
      "hint": "Watch the dot! ـغـ has a dot, ـعـ does not."
    },
    {
      "id": "p32",
      "title": "Three-Letter Words",
      "titleArabic": "",
      "hint": "Mufakham (heavy) letters خ ص ض غ ط ق ظ: deep, full sound. Muraqqaq (light) letters: light sound."
    },
    {
      "id": "p33",
      "title": "Three-Letter Words",
      "titleArabic": "",
      "hint": "Watch the shape! ـمـ is a small loop."
    },
    {
      "id": "p34",
      "title": "Three-Letter Words",
      "titleArabic": "",
      "hint": "Go slowly! ـهـ in the middle changes shape the most."
    },
    {
      "id": "p35",
      "title": "Three-Letter Words",
      "titleArabic": "",
      "hint": "Shadda ( ّ ) means the letter is said twice."
    }
  ],
